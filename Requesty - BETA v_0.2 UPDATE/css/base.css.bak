* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Paleta Pantone Floral */
    --pantone-terracotta: #C15C24; /* PANTONE 6259 C */
    --pantone-plum:       #3E2834; /* PANTONE 6322 C */
    --pantone-taupe:      #5E504F; /* PANTONE 6441 C */
    --pantone-crimson:    #9D2227; /* PANTONE 6294 C */
    --pantone-blush:      #E5C7C9; /* PANTONE 6268 C */

    /* Variables Globales del Sistema */
    --color-bg-primary: #F7EEED;
    --color-sidebar: var(--pantone-plum);
    --color-text-light: #FAF4F5;
    --color-text-muted: #D3B9BB;
    --color-card-bg: #FFFFFF;
    --color-accent: var(--pantone-terracotta);
    --color-accent-dark: var(--pantone-taupe);
    --color-primary: var(--pantone-crimson);
    --color-primary-dark: #7D1A1E;
    --color-highlight: var(--pantone-blush);
    --color-success: #2E7D32;
    --color-danger: var(--pantone-crimson);
    --color-warning: var(--pantone-terracotta);

    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 12px;
    --radius-full: 50%;

    --shadow-sm: 0 2px 5px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.05);
    --shadow-lg: 0 5px 15px rgba(0, 0, 0, 0.2);

    --space-xs: 5px;
    --space-sm: 10px;
    --space-md: 15px;
    --space-lg: 20px;
    --space-xl: 25px;
    --space-2xl: 30px;
    --space-3xl: 40px;

    --font-sm: 12px;
    --font-base: 13px;
    --font-md: 14px;
    --font-lg: 16px;
    --font-xl: 18px;
    --font-2xl: 24px;
    --font-3xl: 28px;
}
  /*estructura general para todos los diseños para seguir acuerdo de paleta de colores*/
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--color-bg-primary);
    overflow: hidden;
}
.container {
    display: flex;
    height: 100vh;
}
.sidebar {
    width: 250px;
    flex: 0 0 250px;
    background-color: var(--color-sidebar);
    padding: 24px 0 16px 0;
    display: flex;
    flex-direction: column;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
    overflow-y: auto;
    overflow-x: hidden;
    position: sticky;
    top: 0;
    align-self: flex-start;
    min-height: 100vh;
    min-height: 100dvh;
    transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1), flex-basis 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
}

.sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-2xl) var(--space-xl) var(--space-2xl);
    border-bottom: 1px solid rgba(229, 199, 201, 0.15);
    margin-bottom: var(--space-md);
}

.sidebar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--font-2xl);
    font-weight: bold;
    color: var(--color-text-light);
    white-space: nowrap;
    user-select: none;
    cursor: pointer;
}

.sidebar-logo .logo-icon {
    color: var(--pantone-terracotta);
    font-size: 22px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
}

.sidebar-logo:hover .logo-icon {
    transform: rotate(-10deg) scale(1.1);
}

.sidebar-logo .logo-text {
    transition: opacity 0.2s ease;
}

.sidebar-toggle-btn {
    background: rgba(229, 199, 201, 0.12);
    border: none;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
}

.sidebar-toggle-btn:hover {
    background: rgba(229, 199, 201, 0.25);
    color: #FFFFFF;
}

.sidebar-toggle-btn .toggle-icon {
    font-size: 13px;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar-menu {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.sidebar-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: var(--space-md) var(--space-2xl);
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: var(--font-md);
    font-weight: 500;
    margin: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
    white-space: nowrap;
}

.sidebar-item .nav-icon {
    width: 20px;
    font-size: 16px;
    text-align: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
}

.sidebar-item .nav-text {
    transition: opacity 0.2s ease;
}

.sidebar-item:hover {
    background-color: rgba(229, 199, 201, 0.15);
    color: #FFFFFF;
}

.sidebar-item:hover .nav-icon {
    transform: scale(1.12);
    color: #FFFFFF;
}

/* Animación de Ola en el Elemento Activo */
.sidebar-item.active {
    background: linear-gradient(90deg, var(--color-accent) 0%, #D86B2F 45%, var(--pantone-crimson) 100%);
    background-size: 200% 100%;
    animation: waveSlide 4s ease infinite alternate;
    color: #FFFFFF;
    font-weight: bold;
    box-shadow: 0 4px 12px rgba(193, 92, 36, 0.35);
    position: relative;
}

/* Cresta de la ola en el borde */
.sidebar-item.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: #FFFFFF;
    border-radius: 0 4px 4px 0;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.85);
    animation: wavePulse 2s ease-in-out infinite alternate;
}

/* Efecto de resplandor ondulante suave */
.sidebar-item.active::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 60%);
    animation: waveRipple 6s linear infinite;
    pointer-events: none;
}

@keyframes waveSlide {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
}

@keyframes wavePulse {
    0% { opacity: 0.65; transform: scaleY(0.75); }
    100% { opacity: 1; transform: scaleY(1); }
}

@keyframes waveRipple {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.sidebar-footer {
    border-top: 1px solid rgba(229, 199, 201, 0.2);
    padding-top: var(--space-md);
    margin-top: auto;
    flex-shrink: 0;
}

.sidebar-profile {
    padding: var(--space-md) var(--space-2xl);
    display: flex;
    align-items: center;
    gap: var(--space-md);
}

.profile-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
    font-weight: bold;
    flex-shrink: 0;
}

.profile-info {
    overflow: hidden;
}

.profile-info h4 {
    font-size: var(--font-base);
    margin-bottom: 3px;
    color: var(--color-text-light);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.profile-info p {
    color: var(--color-text-muted);
    font-size: 11px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Cerrar Sesión remarcado en Rojo bajo el nombre */
.sidebar-item-logout {
    background-color: rgba(157, 34, 39, 0.2) !important;
    border: 1px solid rgba(157, 34, 39, 0.55);
    color: #FFAEAE !important;
    margin: 8px var(--space-md) 4px !important;
    border-radius: var(--radius-md) !important;
}

.sidebar-item-logout .nav-icon {
    color: #FF666C;
}

.sidebar-item-logout:hover {
    background-color: var(--pantone-crimson) !important;
    border-color: #FFAEAE !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(157, 34, 39, 0.45);
}

.sidebar-item-logout:hover .nav-icon {
    color: #FFFFFF !important;
    transform: translateX(2px) scale(1.1);
}

/* ========================================================
   ESTADO COLAPSADO / DESPLEGADO DEL MENÚ LATERAL
   ======================================================== */
.sidebar.collapsed,
body.sidebar-collapsed .sidebar {
    width: 70px !important;
    flex: 0 0 70px !important;
    padding-left: 0;
    padding-right: 0;
}

.sidebar.collapsed .sidebar-header,
body.sidebar-collapsed .sidebar-header {
    padding: 16px 0;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
}

.sidebar.collapsed .logo-text,
body.sidebar-collapsed .logo-text {
    display: none !important;
}

.sidebar.collapsed .logo-icon,
body.sidebar-collapsed .logo-icon {
    font-size: 22px;
    margin: 0;
}

.sidebar.collapsed .sidebar-toggle-btn .toggle-icon,
body.sidebar-collapsed .sidebar-toggle-btn .toggle-icon {
    transform: rotate(180deg);
}

.sidebar.collapsed .sidebar-item,
body.sidebar-collapsed .sidebar-item {
    justify-content: center;
    padding: 12px 0;
    margin: 4px 8px;
    gap: 0;
}

.sidebar.collapsed .sidebar-item .nav-icon,
body.sidebar-collapsed .sidebar-item .nav-icon {
    font-size: 18px;
    width: auto;
    margin: 0;
}

.sidebar.collapsed .sidebar-item .nav-text,
body.sidebar-collapsed .sidebar-item .nav-text {
    display: none !important;
}

.sidebar.collapsed .sidebar-profile,
body.sidebar-collapsed .sidebar-profile {
    justify-content: center;
    padding: 10px 0;
}

.sidebar.collapsed .profile-info,
body.sidebar-collapsed .profile-info {
    display: none !important;
}

.sidebar.collapsed .profile-avatar,
body.sidebar-collapsed .profile-avatar {
    margin: 0 auto;
}

.sidebar.collapsed .sidebar-item-logout,
body.sidebar-collapsed .sidebar-item-logout {
    justify-content: center;
    padding: 12px 0;
    margin: 8px 8px 4px !important;
}

.sidebar.collapsed .sidebar-item-logout .nav-text,
body.sidebar-collapsed .sidebar-item-logout .nav-text {
    display: none !important;
}

/* Tooltip flotante al pasar el cursor sobre los iconos colapsados */
.sidebar.collapsed .sidebar-item:hover::after,
body.sidebar-collapsed .sidebar .sidebar-item:hover::after {
    content: attr(data-title);
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--pantone-plum);
    color: #FFFFFF;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(229, 199, 201, 0.3);
    pointer-events: none;
    z-index: 9999;
    animation: fadeInTooltip 0.15s ease-out;
}

@keyframes fadeInTooltip {
    from { opacity: 0; transform: translateY(-50%) translateX(-4px); }
    to { opacity: 1; transform: translateY(-50%) translateX(0); }
}

/* Tooltip flotante al pasar el cursor sobre los iconos colapsados */
.sidebar.collapsed .sidebar-item:hover::after,
html.sidebar-is-collapsed .sidebar .sidebar-item:hover::after {
    content: attr(data-title);
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--pantone-plum);
    color: #FFFFFF;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(229, 199, 201, 0.3);
    pointer-events: none;
    z-index: 9999;
    animation: fadeInTooltip 0.15s ease-out;
}

@keyframes fadeInTooltip {
    from { opacity: 0; transform: translateY(-50%) translateX(-4px); }
    to { opacity: 1; transform: translateY(-50%) translateX(0); }
}

/* Modal de Confirmación de Cierre de Sesión */
.rq-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(62, 40, 52, 0.72);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 999999;
    opacity: 0;
    transition: opacity 0.22s ease;
}

.rq-modal-overlay.show {
    opacity: 1;
}

.rq-modal-card {
    background: #FFFFFF;
    width: 90%;
    max-width: 420px;
    border-radius: 18px;
    padding: 32px 28px 24px;
    text-align: center;
    box-shadow: 0 20px 50px rgba(62, 40, 52, 0.35);
    border: 1.5px solid var(--pantone-blush);
    transform: scale(0.92);
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.rq-modal-overlay.show .rq-modal-card {
    transform: scale(1);
}

.rq-modal-icon-danger {
    width: 68px;
    height: 68px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: rgba(157, 34, 39, 0.12);
    border: 2px solid rgba(157, 34, 39, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    color: var(--pantone-crimson);
}

.rq-modal-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--pantone-plum);
    margin-bottom: 10px;
}

.rq-modal-message {
    font-size: 14px;
    color: var(--pantone-taupe);
    line-height: 1.5;
    margin-bottom: 24px;
}

.rq-modal-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.rq-btn-secondary {
    flex: 1;
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    border: 1.5px solid var(--pantone-taupe);
    background: #FFFFFF;
    color: var(--pantone-plum);
    cursor: pointer;
    transition: all 0.2s ease;
}

.rq-btn-secondary:hover {
    background: #F7EEED;
    border-color: var(--pantone-plum);
}

.rq-btn-danger {
    flex: 1.3;
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    border: 1.5px solid var(--pantone-crimson);
    background: var(--pantone-crimson);
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(157, 34, 39, 0.35);
}

.rq-btn-danger:hover {
    background: #7D1A1E;
    border-color: #7D1A1E;
    box-shadow: 0 6px 18px rgba(157, 34, 39, 0.5);
    color: #FFFFFF;
}

.main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-primary);
    min-width: 0;
}

.top-bar {
    background-color: var(--color-card-bg);
    padding: 14px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(193, 92, 36, 0.2);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
}

.topbar-left {
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 1;
}

.topbar-toggle-btn {
    background: transparent;
    border: 1.5px solid rgba(62, 40, 52, 0.2);
    border-radius: 8px;
    width: 36px;
    height: 36px;
    cursor: pointer;
    color: var(--color-sidebar);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    transition: all 0.2s ease;
}

.topbar-toggle-btn:hover {
    background: var(--pantone-terracotta);
    border-color: var(--pantone-terracotta);
    color: #FFFFFF;
}

.top-bar::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    width: 80px;
    height: 70px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    clip-path: polygon(100% 0, 0 0, 100% 100%);
}

.restaurant-name {
    font-weight: bold;
    color: var(--color-sidebar);
    font-size: var(--font-lg);
    z-index: 1;
}

.content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-3xl);
}

.page-header {
    margin-bottom: var(--space-2xl);
}
.page-title {
    font-size: var(--font-3xl);
    font-weight: bold;
    color: var(--color-sidebar);
    margin-bottom: var(--space-lg);
}



html,
body {
    min-width: 320px;
    min-height: 100%;
}

body {
    overflow-x: hidden;
    overflow-y: auto;
}

.container {
    min-height: 100vh;
    min-height: 100dvh;
    height: auto;
    align-items: stretch;
}


.main-content {
    min-width: 0;
    min-height: 100vh;
    min-height: 100dvh;
    height: auto;
}

.content,
.content-wrapper,
main {
    min-width: 0;
}

.top-bar {
    flex-shrink: 0;
}

.restaurant-name {
    min-width: 0;
    overflow-wrap: anywhere;
}

img,
canvas,
video,
svg {
    max-width: 100%;
}

.table-wrapper,
.table-card,
.tabla-scroll,
.tabla-inventario-scroll,
.table-scroll {
    max-width: 100%;
    overflow-x: auto;
}

.modal,
.modal-overlay,
dialog {
    max-width: calc(100vw - 24px);
    max-height: calc(100dvh - 24px);
    overflow: auto;
}

@media (max-width: 900px) {
    .sidebar:not(.collapsed) {
        flex-basis: 220px;
        width: 220px;
    }

    .content,
    .content-wrapper {
        padding: clamp(16px, 3vw, 28px);
    }

    .top-bar {
        padding-right: clamp(20px, 4vw, 40px);
        padding-left: clamp(20px, 4vw, 40px);
    }
}

@media (max-width: 800px) {
    .main-content {
        min-height: 0;
        width: 100%;
    }

    .top-bar {
        padding: 14px 18px;
    }

    .content,
    .content-wrapper {
        width: 100%;
        padding: clamp(14px, 4vw, 24px);
    }

    .content-wrapper {
        max-width: none;
    }

    .page-header,
    .main-header,
    .header-actions,
    .filters-section,
    .filters-actions,
    .chart-header,
    .encabezado-menu {
        flex-wrap: wrap;
        gap: 12px;
    }

    .page-title {
        font-size: clamp(22px, 6vw, var(--font-3xl));
        overflow-wrap: anywhere;
    }

    .toolbar {
        align-items: stretch;
    }

    .search-box {
        min-width: 0;
        flex-basis: 100%;
    }

    .filter-tabs,
    .filters-actions {
        width: 100%;
    }

    .kpi-container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filters-section .date-input {
        min-width: 0;
        flex: 1 1 140px;
    }

    .filters-actions > button {
        flex: 1 1 140px;
    }

    .form-grid,
    .formulario,
    .formulario-inventario,
    .grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .grid-full,
    .campo-ingredientes,
    .acciones-formulario,
    .formulario-inventario .acciones-formulario {
        grid-column: 1 / -1;
    }

    .mesas-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .orders-table {
        min-width: 900px;
    }

    .orders-table th,
    .orders-table td {
        white-space: nowrap;
    }

    .modal-content,
    .modal-box,
    .card,
    .panel {
        max-width: 100%;
    }
}

@media (max-width: 480px) {
    .top-bar {
        padding: 12px 14px;
    }

    .restaurant-name {
        font-size: var(--font-md);
    }

    .kpi-container,
    .mesas-stats {
        grid-template-columns: minmax(0, 1fr);
    }

    .kpi-card,
    .chart-section,
    .card,
    .panel {
        padding: 16px;
    }

    .actions,
    .acciones-formulario,
    .form-actions {
        flex-wrap: wrap;
    }

    .actions > button,
    .acciones-formulario > button,
    .form-actions > button {
        flex: 1 1 100%;
    }

}
