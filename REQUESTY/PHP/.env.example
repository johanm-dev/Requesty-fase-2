# Configuracion de entorno para Requesty PHP + PostgreSQL 17 (restaurante_db)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=restaurante_db
DB_SCHEMA=restaurante
DB_USER=app_restaurante_rw
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO_ROL_APP
DB_SSL_MODE=prefer

# Pool / PDO timeouts
DB_CONNECTION_TIMEOUT=2

# Secretos criptograficos obligatorios (>= 32 caracteres)
APP_ENCRYPTION_KEY=REEMPLAZAR_CON_LLAVE_AES256_MINIMO_32_CARACTERES
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_HS256_MINIMO_32_CARACTERES
JWT_EXPIRATION_SECONDS=900

# CORS estricto por lista blanca (sin comodin *)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088

# Cookies de sesion web (true en produccion HTTPS)
SESSION_SECURE=true
