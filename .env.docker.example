# Copiar a .env.docker (o .env) antes de ejecutar: docker compose --env-file .env.docker up -d --build
# Nunca versionar secretos reales en Git

WEB_PORT=8080

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=REEMPLAZAR_ADMIN_PG_PASSWORD

DB_NAME=restaurante_db
DB_SCHEMA=restaurante
DB_USER=app_restaurante_rw
DB_PASSWORD=REEMPLAZAR_APP_RW_PASSWORD_SEGURO
DB_SSL_MODE=prefer
DB_CONNECTION_TIMEOUT=5

# Secretos criptograficos obligatorios (>= 32 caracteres / >= 256 bits)
APP_ENCRYPTION_KEY=REEMPLAZAR_LLAVE_AES256_MINIMO_32_CARACTERES
JWT_SECRET=REEMPLAZAR_SECRETO_JWT_HS256_MINIMO_32_CARACTERES
JWT_EXPIRATION_SECONDS=900

CORS_ALLOWED_ORIGINS=https://app.restaurante.local,http://127.0.0.1:8080
SESSION_SECURE=true
